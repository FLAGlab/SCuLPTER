{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://darkoyd.github.io/SCuLPTER/",
  "dependencies": {
    "source-map-support": "^0.5.21"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:simulator": "node scripts/build-simulator.mjs",
    "test": "npm run build:simulator && npm run test:simulador && npm run test:lector",
    "test:simulador": "node --test simulador/tests/*.test.mjs",
    "test:lector": "python3 -m pytest lector/tests",
    "test:mesa": "node --test simulador/tests/*.spec.mjs"
  },
  "devDependencies": {
    "@scala-js/vite-plugin-scalajs": "^1.0.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.63.0",
    "vite": "^6.2.1"
  }
}
