{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://darkoyd.github.io/SCuLPTER/",
  "dependencies": {
    "source-map-support": "^0.5.21"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:simulator": "node scripts/build-simulator.mjs",
    "test:simulator": "node --test vision-prototype/simulador_3d/tests/*.test.mjs",
    "test:vision": "PYTHONPATH=vision-prototype python3 -m unittest discover -s vision-prototype/tests",
    "test:mesa": "node --test vision-prototype/simulador_3d/tests/*.spec.mjs",
    "test": "npm run build:simulator && npm run test:simulator && npm run test:vision"
  },
  "devDependencies": {
    "@scala-js/vite-plugin-scalajs": "^1.0.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.63.0",
    "vite": "^6.2.1"
  }
}
